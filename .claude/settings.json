{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(./scripts/*)",
      "Bash(../scripts/*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(gh:*)",
      "Bash(curl:*)",
      "Bash(jq:*)",
      "Bash(ls:*)",
      "Bash(tree:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(docker ps:*)",
      "Bash(docker images:*)",
      "Bash(docker logs:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose pull:*)",
      "Bash(docker compose up:*)",
      "Bash(docker build:*)",
      "Bash(docker push:*)",
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(npm list:*)",
      "Bash(npm ci:*)",
      "Bash(npx:*)",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go run:*)",
      "WebSearch",
      "WebFetch",
      "mcp__grok__*",
      "mcp__playwright__*"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit-svelte-check.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
